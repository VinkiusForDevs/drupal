<?php

/**
 * @file
 * Vinkius Connector module.
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function vinkius_connector_help($route_name, RouteMatchInterface $route_match) {
  if ($route_name === 'help.page.vinkius_connector') {
    return ['#markup' => 'Vinkius Connector'];
  }
  return NULL;
}

// ---------------------------------------------------------------------------
// Module constants (also used by the ported WordPress-compatible classes).
// ---------------------------------------------------------------------------

if (!defined('MINUTE_IN_SECONDS')) {
  define('MINUTE_IN_SECONDS', 60);
}
if (!defined('HOUR_IN_SECONDS')) {
  define('HOUR_IN_SECONDS', 3600);
}
if (!defined('DAY_IN_SECONDS')) {
  define('DAY_IN_SECONDS', 86400);
}
if (!defined('WEEK_IN_SECONDS')) {
  define('WEEK_IN_SECONDS', 604800);
}

if (!defined('VC_VERSION')) {
  define('VC_VERSION', '1.0.0');
}
if (!defined('VC_PLUGIN_DIR')) {
  define('VC_PLUGIN_DIR', __DIR__ . '/');
}
if (!defined('VC_PLUGIN_URL')) {
  define('VC_PLUGIN_URL', '/' . \Drupal::service('extension.list.module')->getPath('vinkius_connector') . '/');
}
if (!defined('VC_PLUGIN_BASENAME')) {
  define('VC_PLUGIN_BASENAME', 'vinkius_connector');
}
if (!defined('VC_TEXT_DOMAIN')) {
  define('VC_TEXT_DOMAIN', 'vinkius-connector');
}
if (!defined('VC_API_BASE_URL')) {
  define('VC_API_BASE_URL', 'https://api.vinkius.com');
}
if (!defined('VC_FRONTEND_BASE_URL')) {
  define('VC_FRONTEND_BASE_URL', 'https://cloud.vinkius.com');
}
if (!defined('ABSPATH')) {
  define('ABSPATH', __DIR__ . '/');
}

// ---------------------------------------------------------------------------
// WordPress compatibility helpers used by ported code.
// ---------------------------------------------------------------------------

if (!function_exists('__')) {
  function __($text, $domain = NULL) { return $text; }
}
if (!function_exists('esc_html')) {
  function esc_html($text) { return htmlspecialchars((string) $text, ENT_QUOTES, 'UTF-8'); }
}
if (!function_exists('esc_attr')) {
  function esc_attr($text) { return htmlspecialchars((string) $text, ENT_QUOTES, 'UTF-8'); }
}
if (!function_exists('esc_url')) {
  function esc_url($url) { return (string) $url; }
}
if (!function_exists('esc_html__')) {
  function esc_html__($text, $domain = NULL) { return esc_html($text); }
}
if (!function_exists('esc_attr__')) {
  function esc_attr__($text, $domain = NULL) { return esc_attr($text); }
}
if (!function_exists('esc_html_e')) {
  function esc_html_e($text, $domain = NULL) { echo esc_html($text); }
}
if (!function_exists('esc_attr_e')) {
  function esc_attr_e($text, $domain = NULL) { echo esc_attr($text); }
}
if (!function_exists('_e')) {
  function _e($text, $domain = NULL) { echo $text; }
}
if (!function_exists('sanitize_text_field')) {
  function sanitize_text_field($str) { return trim(strip_tags((string) $str)); }
}
if (!function_exists('sanitize_title')) {
  function sanitize_title($title) { return strtolower(preg_replace('/[^a-z0-9]+/', '-', (string) $title)); }
}
if (!function_exists('wp_json_encode')) {
  function wp_json_encode($data) { return json_encode($data); }
}
if (!function_exists('current_time')) {
  function current_time($type, $gmt = 0) { return gmdate('Y-m-d H:i:s'); }
}
if (!function_exists('sanitize_email')) {
  function sanitize_email($email) { return filter_var($email, FILTER_SANITIZE_EMAIL); }
}
if (!function_exists('wp_verify_nonce')) {
  function wp_verify_nonce($nonce, $action) { return TRUE; }
}
if (!function_exists('wp_create_nonce')) {
  function wp_create_nonce($action) { return \Drupal::csrfToken()->get(); }
}
if (!function_exists('check_admin_referer')) {
  function check_admin_referer($action = -1, $query_arg = '_wpnonce') { return TRUE; }
}
if (!function_exists('rest_ensure_response')) {
  function rest_ensure_response($data) { return $data; }
}
if (!function_exists('get_bloginfo')) {
  function get_bloginfo($show) {
    if ($show === 'name') { return \Drupal::config('system.site')->get('name'); }
    if ($show === 'description') { return \Drupal::config('system.site')->get('slogan'); }
    if ($show === 'url') { return \Drupal::request()->getSchemeAndHttpHost(); }
    return '';
  }
}
if (!function_exists('get_site_url')) {
  function get_site_url() { return \Drupal::request()->getSchemeAndHttpHost(); }
}
if (!function_exists('admin_url')) {
  function admin_url($path = '') { return '/admin/config/vinkius'; }
}
if (!function_exists('rest_url')) {
  function rest_url($path = '') { $path = preg_replace('#^vinkius/v1/#', '', ltrim($path, '/')); return '/vinkius/ajax?route=' . urlencode($path); }
}
if (!function_exists('plugin_dir_path')) {
  function plugin_dir_path($file) { return VC_PLUGIN_DIR; }
}
if (!function_exists('plugin_dir_url')) {
  function plugin_dir_url($file) { return VC_PLUGIN_URL; }
}
if (!function_exists('plugin_basename')) {
  function plugin_basename($file) { return 'vinkius_connector'; }
}
if (!function_exists('load_plugin_textdomain')) {
  function load_plugin_textdomain($domain, $deprecated = FALSE, $plugin_rel_path = FALSE) { return TRUE; }
}
if (!function_exists('add_action')) {
  function add_action($hook, $callback, $priority = 10, $accepted_args = 1) { return TRUE; }
}
if (!function_exists('add_filter')) {
  function add_filter($hook, $callback, $priority = 10, $accepted_args = 1) { return TRUE; }
}
if (!function_exists('do_action')) {
  function do_action($hook, ...$args) { return NULL; }
}
if (!function_exists('apply_filters')) {
  function apply_filters($hook, $value, ...$args) { return $value; }
}
if (!function_exists('wp_enqueue_style')) { function wp_enqueue_style(...$a) {} }
if (!function_exists('wp_enqueue_script')) { function wp_enqueue_script(...$a) {} }
if (!function_exists('wp_localize_script')) { function wp_localize_script(...$a) {} }
if (!function_exists('is_wp_error')) { function is_wp_error($thing) { return $thing instanceof \WP_Error; } }
if (!function_exists('wp_unslash')) { function wp_unslash($v) { return $v; } }
if (!function_exists('wp_parse_args')) {
  function wp_parse_args($args, $defaults = []) {
    if (is_object($args)) { $args = get_object_vars($args); }
    if (!is_array($args)) { $args = []; }
    return array_merge($defaults, $args);
  }
}
if (!function_exists('current_user_can')) {
  function current_user_can($cap) {
    return \Drupal::currentUser()->hasPermission('administer vinkius connector');
  }
}
if (!function_exists('wp_safe_redirect')) {
  function wp_safe_redirect($location) { header('Location: ' . $location); exit; }
}
if (!function_exists('add_query_arg')) {
  function add_query_arg($args, $url = '') {
    if (is_array($args)) {
      $q = http_build_query($args);
      return $url . '?' . $q;
    }
    return $url;
  }
}
if (!function_exists('wp_die')) {
  function wp_die($msg = '') { echo $msg; exit; }
}
if (!function_exists('get_current_user_id')) {
  function get_current_user_id() { return (int) \Drupal::currentUser()->id(); }
}
if (!function_exists('get_locale')) {
  function get_locale() { return 'en_US'; }
}
if (!function_exists('wp_rand')) {
  function wp_rand($min = 0, $max = 0) { return random_int($min ?: 0, $max ?: mt_getrandmax()); }
}
if (!function_exists('wp_generate_password')) {
  function wp_generate_password($length = 12, $special = TRUE, $extra = FALSE) {
    $chars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
    if ($special) { $chars .= '!@#$%^&*()'; }
    $out = '';
    for ($i = 0; $i < $length; $i++) { $out .= $chars[random_int(0, strlen($chars) - 1)]; }
    return $out;
  }
}
if (!function_exists('wp_salt')) {
  function wp_salt($scheme = 'auth') {
    return \Drupal::service('private_key')->get('vinkius_connector_salt');
  }
}
if (!function_exists('wp_nonce_field')) {
  function wp_nonce_field($action, $name = '_wpnonce', $referer = TRUE, $echo = TRUE) {
    $field = '<input type="hidden" name="' . $name . '" value="' . \Drupal::csrfToken()->get() . '" />';
    if ($echo) { echo $field; return NULL; }
    return $field;
  }
}
if (!function_exists('wp_next_scheduled')) { function wp_next_scheduled($hook) { return FALSE; } }
if (!function_exists('wp_schedule_event')) { function wp_schedule_event(...$a) { return TRUE; } }
if (!function_exists('wp_mail')) { function wp_mail(...$a) { return TRUE; } }
if (!function_exists('add_shortcode')) { function add_shortcode(...$a) { return TRUE; } }
if (!function_exists('wp_clear_scheduled_hook')) { function wp_clear_scheduled_hook(...$a) { return TRUE; } }

// Options and transients backed by Drupal state.
if (!function_exists('get_option')) {
  function get_option($key, $default = FALSE) {
    $all = \Drupal::state()->get('vinkius_connector_options', []);
    if (!is_array($all) || !array_key_exists($key, $all)) { return $default; }
    return $all[$key];
  }
}
if (!function_exists('update_option')) {
  function update_option($key, $value) {
    $all = \Drupal::state()->get('vinkius_connector_options', []);
    if (!is_array($all)) { $all = []; }
    $all[$key] = $value;
    \Drupal::state()->set('vinkius_connector_options', $all);
    return TRUE;
  }
}
if (!function_exists('delete_option')) {
  function delete_option($key) {
    $all = \Drupal::state()->get('vinkius_connector_options', []);
    if (is_array($all) && array_key_exists($key, $all)) {
      unset($all[$key]);
      \Drupal::state()->set('vinkius_connector_options', $all);
    }
    return TRUE;
  }
}
if (!function_exists('get_transient')) {
  function get_transient($key) { return get_option($key, FALSE); }
}
if (!function_exists('set_transient')) {
  function set_transient($key, $value, $expiration = 0) { return update_option($key, $value); }
}
if (!function_exists('delete_transient')) {
  function delete_transient($key) { return delete_option($key); }
}

// HTTP shims backed by Drupal's Guzzle client.
if (!class_exists('WP_Error')) {
  class WP_Error {
    private $code;
    private $message;
    public function __construct($code = '', $message = '') { $this->code = $code; $this->message = $message; }
    public function get_error_code() { return $this->code; }
    public function get_error_message() { return $this->message; }
  }
}
if (!function_exists('wp_remote_request')) {
  function wp_remote_request($url, $args = []) {
    try {
      $client = \Drupal::httpClient();
      $options = [];
      if (!empty($args['headers'])) { $options['headers'] = $args['headers']; }
      if (!empty($args['timeout'])) { $options['timeout'] = $args['timeout']; }
      if (isset($args['body'])) { $options['body'] = $args['body']; }
      $method = strtoupper($args['method'] ?? 'GET');
      $response = $client->request($method, $url, $options);
      return [
        'response' => ['code' => $response->getStatusCode()],
        'body' => (string) $response->getBody(),
      ];
    }
    catch (\Throwable $e) {
      return new WP_Error('http_error', $e->getMessage());
    }
  }
}
if (!function_exists('wp_remote_retrieve_response_code')) {
  function wp_remote_retrieve_response_code($response) {
    return is_array($response) && isset($response['response']['code']) ? (int) $response['response']['code'] : 0;
  }
}
if (!function_exists('wp_remote_retrieve_body')) {
  function wp_remote_retrieve_body($response) {
    return is_array($response) && isset($response['body']) ? (string) $response['body'] : '';
  }
}

require_once VC_PLUGIN_DIR . 'includes/wp-rest-shims.php';
require_once VC_PLUGIN_DIR . 'includes/autoload.php';
if (class_exists('VinkiusConnector\Options')) { \VinkiusConnector\Options::ensure_defaults(); }
